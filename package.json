{
  "name": "hexnote",
  "version": "0.0.0",
  "private": true,
  "description": "六角セルの音符と PC キーボードの鍵盤で遊ぶ音ゲー（ヘクサノート）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --manifest",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses": "node tools/licenses/check-deps.ts",
    "licenses:files": "node tools/licenses/check-license-files.ts",
    "charts:validate": "node tools/charts/validate-charts.ts content/charts",
    "charts:rights": "node tools/charts/check-rights.ts content/charts",
    "size": "node tools/size/check-initial-load.ts dist",
    "check": "npm run licenses && npm run licenses:files && npm run charts:rights && npm run typecheck && npm test && npm run charts:validate",
    "charts:fixtures": "node tools/charts/from-mel.ts",
    "charts:fixtures:check": "node tools/charts/from-mel.ts --check",
    "charts:validate:fixtures": "node tools/charts/validate-charts.ts tests/fixtures/charts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
